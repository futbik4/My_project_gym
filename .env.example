# PostgreSQL Конфигурация базы данных
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=your_database_password_here

# Конфигурация базы данных Django
DB_PASSWORD=your_database_password_here
DATABASE_URL=postgres://gym_user:your_database_password_here@db:5432/gym_db

# Настройки приложения Django
DJANGO_SECRET_KEY=your-django-secret-key-here-change-this
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0